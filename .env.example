# ==============================================
# BASE DE DATOS (MySQL Externo / Servidor Local)
# ==============================================
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASS=root
MYSQL_DATABASE=inventario_empresa

# ==============================================
# REDIS (Caché & Blacklist de Tokens JWT)
# ==============================================
REDIS_HOST=redis-cache
REDIS_PORT=6379

# ==============================================
# SEGURIDAD JWT (Mínimo 32 caracteres)
# ==============================================
JWT_SECRET=TuClaveSecretaSuperSeguraParaJWT2026ConMasDe32Caracteres!

# ==============================================
# SERVICIO DE CORREOS (Spring Mail - Gmail SMTP)
# ==============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion

# ==============================================
# CLOUDINARY (Imágenes de productos / perfil)
# ==============================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ==============================================
# PUERTOS Y URLs DE COMUNICACIÓN
# ==============================================
BACKEND_PORT=8082
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8082
APP_FRONTEND_URL=http://localhost:5173
